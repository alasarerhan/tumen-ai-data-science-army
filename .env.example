# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth
AUTH_MODE=oidc  # dev|oidc
DEV_AUTH_TOKEN=REPLACE_ME_LOCAL_ONLY
DEV_AUTH_EMAIL=dev@example.local
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=REPLACE_ME
OIDC_JWKS_URL=

# Database
DATABASE_URL=sqlite:///./platform.db

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_STRATEGY=gpt-3.5-turbo

# Frontend
# Vite reads this repo-root env file through frontend/vite.config.ts envDir.
VITE_API_BASE_URL=
VITE_AUTH_MODE=dev
VITE_DEV_AUTH_TOKEN=dev
VITE_OIDC_LOGIN_URL=
VITE_PREFECT_UI_BASE_URL=

# Data source secrets
# Required for release deployments that store SQL Server credentials.
DATA_SOURCE_SECRET_KEY=REPLACE_ME_32_PLUS_RANDOM_CHARS

# Prefect
# Prefect uses PREFECT_API_URL / PREFECT_API_KEY in the environment.
PREFECT_HELLO_DEPLOYMENT_ID=
