[flake8]
max-line-length = 200
exclude =
    __pycache__,
    .git,
    .venv,
    venv,
    *.egg-info,
    build,
    dist

# __init__.py files are used for re-exporting public API symbols.
# Test files may import fixtures/modules without using them directly.
per-file-ignores =
    */__init__.py:F401
    tests/*.py:F401
    */tests/*.py:F401
