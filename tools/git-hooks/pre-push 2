#!/usr/bin/env bash
#
# pre-push hook
# ----------------
# Runs four gates before any `git push`:
#   1. syntax_check   — `python -m py_compile` on every .py file in the push.
#   2. import_check   — every module that the project imports can actually be
#                       imported (catches missing / broken modules early).
#   3. lint           — flake8, honouring the project's .flake8 config.
#   4. type_check     — mypy in non-fatal mode; reports errors but does NOT
#                       block the push (this codebase predates a strict
#                       type-harness and abrupt --strict would brick push).
#
# Scope: only the .py files changed between the local branch HEAD and the
# remote tracking ref that is about to be pushed.  This keeps the hook fast
# even on a large repo.
#
# Install:  cp .git/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# (Already installed by this commit if you ran the install command in the README.)
#
# Bypass (USE CAREFULLY):  git push --no-verify

set -u

# ----- locate the hooks config ----------------------------------------------

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GIT_DIR="$(git rev-parse --git-dir)"
REPO_ROOT="$(git rev-parse --show-toplevel)"

PY="${PYTHON:-python}"
# Prefer the project virtualenv's python (which has the installed deps)
# when present; otherwise fall back to whatever $PYTHON is set to.
# Without this, the import check uses the system python and reports
# 500+ spurious "ModuleNotFoundError" failures.
if [ -z "${PYTHON:-}" ] && [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PY="$REPO_ROOT/.venv/bin/python"
fi
FLAKE8="${FLAKE8:-flake8}"
MYPY="${MYPY:-mypy}"

red()   { printf "\033[31m%s\033[0m\n" "$*"; }
green() { printf "\033[32m%s\033[0m\n" "$*"; }
blue()  { printf "\033[34m%s\033[0m\n" "$*"; }

blue "==> pre-push: collecting changed Python files"

# ----- 0. Determine which Python files are about to be pushed ---------------

# `git diff` lists files modified between local HEAD and its upstream.
# The push ref is in $2 (when invoked by git).  We also try the upstream of HEAD
# as a fallback.  The list is union'd so we cover both added and modified files.
PY_FILES=()

# Read the refspecs git pushes on stdin (one per line, 4 fields:
# local_ref local_sha remote_ref remote_sha).  When run by hand there is no
# stdin, so fall back to the configured upstream of the current branch.
if [ -t 0 ]; then
    # Manual invocation: walk every local branch that has an upstream.
    while IFS= read -r refline; do
        branch="${refline%% *}"
        upstream="${refline##* }"
        upstream_sha="$(git rev-parse "${upstream}" 2>/dev/null || true)"
        if [ -z "$upstream_sha" ]; then
            range="4b825dc642cb6eb9a060e54bf8d69288fbee4904..${branch}"
        else
            range="${upstream_sha}..${branch}"
        fi
        while IFS= read -r f; do
            case "$f" in
                *.py) PY_FILES+=("$f") ;;
            esac
        done < <(git diff --name-only --diff-filter=ACMRT "$range" 2>/dev/null)
    done < <(git for-each-ref --format='%(refname:short) %(upstream)' refs/heads 2>/dev/null \
             | awk '$2 != ""')
else
    # Real push: each line on stdin is "local_ref local_sha remote_ref remote_sha".
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -z "${local_ref:-}" ] && continue
        if [ -z "${remote_sha:-}" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
            range="4b825dc642cb6eb9a060e54bf8d69288fbee4904..${local_sha}"
        else
            range="${remote_sha}..${local_sha}"
        fi
        while IFS= read -r f; do
            case "$f" in
                *.py) PY_FILES+=("$f") ;;
            esac
        done < <(git diff --name-only --diff-filter=ACMRT "$range" 2>/dev/null)
    done
fi

if [ "${#PY_FILES[@]}" -eq 0 ]; then
    green "==> no Python files changed; skipping gates."
    exit 0
fi

blue "==> ${#PY_FILES[@]} Python file(s) in this push:"
for f in "${PY_FILES[@]}"; do echo "      - $f"; done

FAIL=0

# ----- 1. syntax_check ------------------------------------------------------

blue "==> [1/4] syntax check (py_compile)"
for f in "${PY_FILES[@]}"; do
    if ! "$PY" -m py_compile "$REPO_ROOT/$f" >/dev/null 2>&1; then
        red "    ✗ syntax error: $f"
        "$PY" -m py_compile "$REPO_ROOT/$f"
        FAIL=1
    fi
done
[ "$FAIL" -eq 0 ] && green "    ✓ all files compile cleanly"

# ----- 2. import_check ------------------------------------------------------

blue "==> [2/4] import check (collect every project module)"
# Walk the installable package directory only. The repo has a dual
# ai_data_science_team/{agents,tools,...} legacy tree (vendored upstream)
# AND ai_data_science_team/ai_data_science_team/ (the platform package);
# per pyproject.toml the installable package is the inner one, so we walk
# that. The legacy tree is exercised by streamlit apps and lives in its
# own test scope.
PACKAGE_DIR="$REPO_ROOT/ai_data_science_team/ai_data_science_team"
if [ ! -d "$PACKAGE_DIR" ]; then
    PACKAGE_DIR="$REPO_ROOT/ai_data_science_team"
fi

# Run from the package dir so sys.path puts the real package first.
# Topologically order imports (parents before children) and skip __init__.py
# to avoid the operator-precedence bug in the previous walker that imported
# every file in os.walk order, causing test modules to load before their
# parents and 500+ false-positive "ModuleNotFoundError" failures.
(
    cd "$(dirname "$PACKAGE_DIR")"
    PYTHONPATH="$(dirname "$PACKAGE_DIR"):${PYTHONPATH:-}" "$PY" - <<PYEOF 2>&1
import importlib, os, sys

# Walk only the package directory; cd-ed into the parent so the dotted
# module names map correctly.
pkg_root = "$(basename "$PACKAGE_DIR")"
pkg_parent = os.getcwd()
sys.path.insert(0, pkg_parent)

modules = []
for root, _dirs, files in os.walk(os.path.join(pkg_parent, pkg_root)):
    for fn in files:
        if not fn.endswith(".py") or fn == "__init__.py":
            continue
        rel = os.path.relpath(os.path.join(root, fn), pkg_parent)
        mod = rel[:-3].replace(os.sep, ".")
        depth = mod.count(".")
        modules.append((depth, mod))
modules.sort()

# Known harmless missing modules: test helper shims referenced by older
# e2e/integration tests but not shipped in the source tree. These are
# LEGACY artefacts; flag them but do not block the push.
_HELPER_BASES = ("_llm", "_gemini_compat")

fails = []
warns = []
for _depth, mod in modules:
    try:
        importlib.import_module(mod)
    except ModuleNotFoundError as exc:
        missing = exc.name if hasattr(exc, "name") else None
        if missing and missing.split(".")[0] in _HELPER_BASES:
            warns.append((mod, type(exc).__name__, str(exc)))
        else:
            fails.append((mod, type(exc).__name__, str(exc)))
    except Exception as exc:
        fails.append((mod, type(exc).__name__, str(exc)))

if warns:
    print(f"  ! {len(warns)} warning(s) (legacy test-helper shims missing):")
    for mod, kind, msg in warns[:5]:
        print(f"      - {mod}: {kind}: {msg}")

if fails:
    print(f"  ✗ {len(fails)} import failure(s):")
    for mod, kind, msg in fails[:25]:
        print(f"      - {mod}: {kind}: {msg}")
    sys.exit(1)
else:
    print(f"  ✓ all {len(modules)} project modules import cleanly")
PYEOF
) || FAIL=1

# ----- 3. lint --------------------------------------------------------------

# Lint is reported but does NOT block the push.  The repo contains
# pre-existing W291 (trailing whitespace) and F541 (f-string without
# placeholder) findings that aren't owned by the current change set; turning
# them into push blockers would brick the workflow for unrelated history.
blue "==> [3/4] lint (flake8, project config — informational only)"
(
    cd "$REPO_ROOT"
    if ! "$FLAKE8" "${PY_FILES[@]}" 2>&1; then
        # Only treat hard *syntax / undefined-name* (E9 / F63 / F7 / F82) as
        # fatal.  These are the categories flake8 documents as bugs-vs-style.
        flake8_out=$("$FLAKE8" --select=E9,F63,F7,F82 "${PY_FILES[@]}" 2>&1) || true
        if [ -n "$flake8_out" ]; then
            red "    ✗ critical lint errors (E9 / F63 / F7 / F82):"
            # Cap the displayed error list at 50 lines to avoid
            # blowing past the parent shell's stdout buffer (which
            # triggers SIGPIPE on bash's printf, manifesting as
            # "printf: Resource temporarily unavailable").  The
            # full output is dumped to a temp file for later
            # inspection.
            flake8_log=$(mktemp -t pre-push-flake8-XXXXXX.log)
            printf '%s\n' "$flake8_out" > "$flake8_log"
            n_errors=$(printf '%s\n' "$flake8_out" | wc -l | tr -d ' ')
            display_lines=$(printf '%s\n' "$flake8_out" | head -n 50)
            printf '%s\n' "$display_lines"
            if [ "$n_errors" -gt 50 ]; then
                echo "    ... ($((n_errors - 50)) more lines truncated; full output: $flake8_log)"
            else
                echo "    (full output: $flake8_log)"
            fi
            FAIL=1
        fi
    fi
) || true

# ----- 4. type_check --------------------------------------------------------

blue "==> [4/4] type check (mypy, non-fatal in this iteration)"
(
    cd "$REPO_ROOT"
    "$MYPY" "${PY_FILES[@]}" --ignore-missing-imports --no-incremental \
        --follow-imports=silent 2>&1 | tail -40
) || true
green "    (mypy output above is informational only — does NOT block push)"

# ----- summary --------------------------------------------------------------

if [ "$FAIL" -ne 0 ]; then
    red ""
    red "==> pre-push FAILED — push blocked."
    red "    Fix the errors above or run:  git push --no-verify"
    exit 1
fi

green ""
green "==> pre-push PASSED — push can proceed."
exit 0