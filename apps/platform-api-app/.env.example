# API
API_HOST=0.0.0.0
API_PORT=8000
DEPLOYMENT_PROFILE=local  # local|release

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth
AUTH_MODE=dev  # dev|oidc (dev only allowed when DEPLOYMENT_PROFILE=local)
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=REPLACE_ME
OIDC_JWKS_URL=

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/platform

# Data source secrets
# Required for release deployments that store SQL Server credentials.
DATA_SOURCE_SECRET_KEY=REPLACE_ME_32_PLUS_RANDOM_CHARS

# Prefect
# Prefect uses PREFECT_API_URL / PREFECT_API_KEY in the environment.
PREFECT_HELLO_DEPLOYMENT_ID=
PREFECT_DEFAULT_DEPLOYMENT_ID=
ALLOW_LOCAL_RUN_FALLBACK=true

# OpenAI — used by the strategy report generator
# Leave empty to fall back to rule-based recommendations.
OPENAI_API_KEY=sk-...
# Model to use for strategy reports (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
