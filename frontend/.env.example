# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Auth mode: "dev" uses Bearer "dev" token; "oidc" uses Google OAuth
VITE_AUTH_MODE=dev

# Application version shown in UI
VITE_APP_VERSION=1.0.0

# Google OAuth Client ID (only needed when VITE_AUTH_MODE=oidc)
# VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
